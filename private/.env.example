# Copy to D:/private/dvapp/.env and restrict filesystem access.
DV_API_BASE_URL=https://dev.deevoch.com/api/phone/v1
DV_API_KEY=
# Disabled until tested with the PBX and Dee Voch; permits charges to saved cards.
ENABLE_RENEWALS=false
# Shared secret supplied by NetSapiens as key. Use a long random value, not DV_API_KEY.
WEBRESPONDER_KEY=
# Public HTTPS URL to public/index.php, without a query string.
WEBRESPONDER_URL=
# NetSapiens dial-plan destination for the office; leave blank to end safely.
OFFICE_DESTINATION=
# Writable private directories
STATE_DIR=D:/private/dvapp/state
LOG_DIR=D:/private/dvapp/logs
CALLER_ID_DIGIT_STYLE=words
TTS_VOICE=
TTS_LANGUAGE=
INPUT_TIMEOUT_SECONDS=6
INTERDIGIT_TIMEOUT_SECONDS=5
MAX_ATTEMPTS=3
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
